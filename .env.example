# ─────────────────────────────────────────────────────────────
# Sushi Smok — konfiguracja płatności
# Skopiuj do `.env`. BEZ tych zmiennych demo działa w trybie mock.
# ─────────────────────────────────────────────────────────────

# mock | stripe | payu | przelewy24
# Gdy wybierzesz providera, ale nie podasz jego kluczy — automatyczny fallback na mock.
PAYMENT_PROVIDER=mock

# Origin aplikacji (redirecty + adres webhooka providera)
APP_URL=http://localhost:5173

# Gdzie zapisywać zamówienia w trybie plikowym
DATA_DIR=.data

# ─────────────── Stripe (Checkout hosted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# klucz publiczny — obie nazwy działają (Vite / Next)
VITE_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─────────────── PayU (REST v2_1)
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_POS_ID=
PAYU_SIGNATURE_KEY=
PAYU_BASE_URL=https://secure.snd.payu.com

# ─────────────── Przelewy24 (REST v1)
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=
P24_BASE_URL=https://sandbox.przelewy24.pl

# ─────────────── Mock (demo)
# Sekret do podpisu webhooka symulatora + tokenów dostępu do zamówień.
# W produkcji ustaw długi losowy ciąg.
MOCK_WEBHOOK_SECRET=zmien-mnie-na-losowy-sekret
